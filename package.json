{
  "name": "finbank-v2-web",
  "version": "0.0.0",
  "private": true,
  "description": "FinBank V2 — frontend Vue",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "cy:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "test:e2e": "npm run build && start-server-and-test preview:e2e http://127.0.0.1:4173 cy:run",
    "test:contract": "node -e \"fs.rmSync('pacts',{recursive:true,force:true})\" && env PACT_DO_NOT_TRACK=true SCARF_ANALYTICS=false vitest run --config vitest.contract.config.ts",
    "test:e2e:stack": "env -u ELECTRON_RUN_AS_NODE cypress run --config-file cypress.stack.config.ts",
    "verify": "npm run audit:prod && npm run lint && npm run typecheck && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "vue": "3.5.45",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "axe-core": "4.14.0",
    "cypress": "16.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "start-server-and-test": "3.0.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": {
        ".": "14.0.6",
        "minimatch": "11.0.8"
      }
    },
    "editorconfig": {
      "minimatch": "11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
